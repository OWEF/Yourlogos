
/* EXACT RESEARCH MODULE: philosophy-engine/encounter/semantic-cases-v12.js */


const semanticSources={
 thoreau:{...transferContexts.thoreau,semantic:{concepts:['price','life exchanged'],relation:'the temporal cost carried by a monetary choice',selection:{central:['conversion'],changeCentral:['transition'],alternatives:[],purpose:'Understand possessions through life exchanged'},boundary:transferContexts.thoreau.limit}},
 smith:{...transferContexts.smith,semantic:{concepts:['divided tasks','joint production'],relation:'the dependence of completed work on coordinated contributions',selection:{central:['dependency'],changeCentral:['transition'],alternatives:[],purpose:'Understand joint production through dependence'},boundary:transferContexts.smith.limit}},
 epictetus:{...transferContexts.epictetus,semantic:{concepts:['our actions','external outcomes'],relation:'the limits of what a chosen action can settle',selection:{central:['agency'],alternatives:[],purpose:'Separate chosen action from external outcome'},boundary:'No path establishes forgiveness, indifference, or a reader’s character.'}},
 descartes:{...transferContexts.descartes,semantic:{concepts:['considering','assenting'],relation:'the need for grounds before accepting a claim',selection:{central:['assent'],alternatives:[],purpose:'Distinguish considering a claim from accepting it'},boundary:transferContexts.descartes.limit}}
};
// Generate a two-stage commitment graph from options and subsequent information.
// No philosopher or quotation identity is consulted by the constructor.
function commitmentScenario({prompt,field,actions,development,initial=[],domain=null,agency=null,assentField=null,variables={}}){
 const options=actions.map(a=>({...a,action:a.label,...(domain?{commitments:{[field]:a.commitment}}:{}),next:'later',reveal:[development]}));
 const later=actions.map(a=>({...a,action:a.label,...(domain?{commitments:{[field]:a.commitment}}:{}),next:null}));
 return {start:'first',initial,agency,assentField,variables,commitmentDomains:domain?{[field]:domain}:null,nodes:{first:{prompt,options},later:{prompt:development,options:later}}};
}
const semanticCases={
 money:constructScenario(semanticSources.thoreau,{model:transferContexts.thoreau.model,development:{id:'essential-bill',kind:'hypothetical_constraint',label:'An essential bill limits the remaining furnishing budget to six $20 tokens.',resourceCaps:{money:6}},initial:{amounts:[1,0,1],budgets:[8],intentions:{lamp:1},repetitions:5}}),
 workshop:constructScenario(semanticSources.smith,{model:transferContexts.smith.model,development:{id:'press-maintenance',kind:'hypothetical_constraint',label:'A safety inspection limits the press to two volunteers for this shift.',choiceCaps:{press:2}},initial:{amounts:[3,1],budgets:[4]}}),
 apology:constructScenario(semanticSources.epictetus,{assumptions:['Choosing a response cannot determine another person’s forgiveness.'],scenario:'You have hurt a friend. Decide whether to offer an apology; their response remains theirs.',model:commitmentScenario({prompt:'What will you do?',field:'response',variables:{apologyOffered:{kind:'event',owner:'self'},forgiveness:{kind:'observation',owner:'external'}},agency:{externalVariable:'forgiveness',own:'whether and when to contact the friend',external:'the friend’s forgiveness'},initial:['Your friend decides whether to forgive.'],development:'Your friend asks for space; forgiveness remains unknown.',actions:[{id:'offer',label:'Offer an apology',commitment:'offer',effects:{apologyOffered:true}},{id:'space',label:'Give space without another message',commitment:'defer'}]}),initial:{path:['offer','space']}}),
 evidence:constructScenario(semanticSources.descartes,{assumptions:['The new archive is relevant but does not settle the disputed attribution.'],scenario:'A historical exhibition contains an uncertain attribution. Decide whether to endorse it as new evidence arrives.',model:commitmentScenario({prompt:'What can the label claim?',field:'assent',assentField:'assent',domain:{states:['assent','withhold'],oppositions:[['assent','withhold']]},initial:['The attribution is disputed.'],development:'An independent archive contradicts the attribution; the dispute remains unresolved.',actions:[{id:'endorse',label:'Endorse the attribution',commitment:'assent'},{id:'suspend',label:'Suspend judgment',commitment:'withhold'}]}),initial:{path:['endorse','suspend']}})
};


/* EXACT RESEARCH MODULE: philosophy-engine/encounter/semantic-reasoning-v12.js */

// Semantic consequences are data, never callbacks or quote-ID dispatch.
const reject=reason=>({version:'meaning/1.2',status:'incompatible',reason});
const stable=x=>JSON.stringify(Object.entries(x||{}).sort(([a],[b])=>a.localeCompare(b)));
function constructScenario(source,scenario){
 if(!source?.quote||!source.source?.url||!source.semantic?.relation||!source.semantic?.concepts?.length)return reject('A sourced relation and concepts are required.');
 return {...source,...scenario,semantic:source.semantic,source:source.source,quote:source.quote};
}
function validateTension(context){
 const fit=mechanismFit(context);
 if(fit.status==='unsupported')return reject(fit.reason);
 const s=context.semantic,m=context.model;
 if(!s?.relation||!s.concepts?.length||!s.boundary)return reject('Missing semantic warrant or interpretive boundary.');
 if(context.mechanism==='decision_map'){
  if(m.agency&&m.variables?.[m.agency.externalVariable]?.owner!=='external')return reject('Agency requires a declared externally owned outcome.');
  for(const node of Object.values(m.nodes)){
   if(node.options.some(o=>!o.action && !o.label))return reject('An observable action is required.');
   for(const o of node.options){
    for(const [field,value] of Object.entries(o.effects||{})){
     const variable=m.variables?.[field];
     if(!variable||variable.owner!=='self')return reject('A chosen action cannot assign an external or undeclared variable.');
     if(variable.kind==='event'&&value!==true)return reject('An occurred event cannot be erased by a later action.');
    }
   }
   for(const o of node.options)for(const [field,value] of Object.entries(o.commitments||{})){
    if(!m.commitmentDomains?.[field]?.states?.includes(value))return reject('Commitment state lacks a declared semantic domain.');
   }
  }
 }
 return {status:'supported',fit};
}

/**
 * Apply a source-authored, explicitly announced hypothetical change.
 * It can restrict an available budget or a choice capacity, never invent a
 * user's motive or alter the first decision. It is not a claim of source truth.
 */
function developedTradeoffModel(context,developmentId){
 const d=context?.development,m=context?.model;
 if(context?.mechanism!=='tradeoff'||!d?.id||d.id!==developmentId||
    typeof d.label!=='string'||!d.label.trim()||d.kind!=='hypothetical_constraint'||
    !m?.resources||!m?.choices)return null;
 const resources=m.resources.map(r=>({...r})),choices=m.choices.map(c=>({...c}));
 let tightened=0;
 const resourceCaps=d.resourceCaps||{},choiceCaps=d.choiceCaps||{};
 if(!Object.keys(resourceCaps).length&&!Object.keys(choiceCaps).length)return null;
 for(const [id,cap] of Object.entries(resourceCaps)){
  const r=resources.find(x=>x.id===id);
  if(!r||!Number.isSafeInteger(cap)||cap<r.min||cap>=r.max||r.type!=='cap')return null;
  r.max=cap;tightened++;
 }
 for(const [id,cap] of Object.entries(choiceCaps)){
  const c=choices.find(x=>x.id===id);
  if(!c||!Number.isSafeInteger(cap)||cap<0||cap>=c.max)return null;
  c.max=cap;tightened++;
 }
 return tightened?{...m,resources,choices}:null;
}

function reasonSemantically(context,input){
 const tension=validateTension(context);if(tension.status!=='supported')return tension;
 const trade=context.mechanism==='tradeoff';
 let transition=null;
 const isSecondMoment=input?.first!==undefined||input?.developmentId!==undefined;
 if(isSecondMoment&&!trade)return reject('Second-moment allocation belongs to Trade-Off only.');
 let structure;
 if(isSecondMoment){
  const developed=developedTradeoffModel(context,input?.developmentId);
  const initial=tradeoffStructure(context.model,input?.first);
  if(!developed||!initial)return reject('The first allocation or declared changed condition is invalid.');
  structure=tradeoffStructure(developed,input);
  if(!structure)return reject('The revised allocation does not fit the changed constraints.');
  const oldChoiceStillFits=Boolean(tradeoffStructure(developed,{amounts:input.first.amounts,budgets:input.budgets}));
  const deltaAmounts=structure.amounts.map((n,i)=>n-initial.amounts[i]);
  const deltaSpent=structure.spent.map((n,i)=>n-initial.spent[i]);
  const amountsChanged=deltaAmounts.some(Boolean);
  transition={
   development:{id:context.development.id,label:context.development.label,kind:context.development.kind},
   initial:{amounts:[...initial.amounts],budgets:[...initial.budgets],spent:[...initial.spent],measure:initial.measure},
   revised:{amounts:[...structure.amounts],budgets:[...structure.budgets],spent:[...structure.spent],measure:structure.measure},
   deltaAmounts,deltaSpent,deltaMetric:initial.measure===null||structure.measure===null?null:structure.measure-initial.measure,
   amountsChanged,originalSelectionStillFeasible:oldChoiceStillFits,
   reallocationRequired:!oldChoiceStillFits
  };
  structure.transition=transition;
 }else{
  structure=trade?tradeoffStructure(context.model,input):decisionStructure(context.model,input?.path);
 }
 if(!structure||!trade&&structure.at!==null)return reject('Incomplete or infeasible selections.');
 const claims=[];
 const add=(kind,text,classification='conditional',evidence={})=>claims.push({kind,text,classification,evidence,assumptions:context.assumptions||[]});
 if(trade){
  const choices=context.model.choices;
  if(transition){
   const unit=context.model.metric?.unit;
   const firstMeasure=transition.initial.measure,secondMeasure=transition.revised.measure;
   const metrics=unit&&firstMeasure!==null&&secondMeasure!==null?
    ' The modeled result moves from '+firstMeasure+' to '+secondMeasure+' '+unit+'.':'';
   const decision=transition.amountsChanged?
    (transition.originalSelectionStillFeasible?
     'Your previous quantities would still fit; this new allocation is a further choice.':
     'Your previous quantities no longer fit; the allocation had to be reconsidered.'):
    'You kept your original quantities despite the new condition.';
   add('transition','In this imagined scenario, '+context.development.label+' '+decision+metrics,
    'conditional',{...transition});
  }
  add('allocation',choices.map((c,i)=>`${input.amounts[i]} ${c.label}`).join(', '),'necessary',{amounts:input.amounts});
  const intentions=input.intentions||{};
  for(const [id,target] of Object.entries(intentions)){
   const i=choices.findIndex(c=>c.id===id);
   if(i<0||!Number.isSafeInteger(target)||target<0)return reject('Invalid stated intention.');
   if(input.amounts[i]<target)add('intention_gap',`Your allocation to ${choices[i].label} falls below your stated target.`, 'necessary',{id,target,actual:input.amounts[i]});
  }
  if(input.repetitions!==undefined){
   if(!Number.isSafeInteger(input.repetitions)||input.repetitions<2||input.repetitions>1000)return reject('Invalid repetition horizon.');
   add('repetition',`Repeating this allocation ${input.repetitions} times repeats its resource demands; it does not establish a habit.`, 'conditional',{totals:structure.spent.map(n=>n*input.repetitions)});
  }
  const better=context.model.metric?.op==='minimum'?structure.alternatives.find(a=>a.delta>0):null;
  if(better)add('complementarity',`Reallocating one unit can increase the modeled result from ${structure.measure} to ${better.measure}.`,'conditional',better);
  else if(structure.alternatives.length)add('opportunity',structure.slack.every(n=>n===0)?'A feasible increase here requires releasing resources elsewhere.':'Unused capacity permits a change without displacing every existing allocation.','conditional',structure.alternatives[0]);
  if(structure.measure!==null)add('conversion',`This allocation corresponds to ${structure.measure} ${context.model.metric.unit}.`,'conditional',{measure:structure.measure,unit:context.model.metric.unit});
 }else{
  const last=structure.steps.at(-1);if(!last)return reject('No decision selected.');
  add('decision',`Your final choice was to ${last.label.toLowerCase()}.`,'necessary',{choice:last.choice});
  const ledger={},changes=[],events=[],unresolved=[],occurred={};
  for(const step of structure.steps){
   const option=context.model.nodes[step.node].options.find(o=>o.id===step.choice);
   Object.assign(occurred,option.effects||{});
   const event={action:option.action||option.label,intention:option.intention||null,before:step.before,externalInformation:step.revealed,occurred:{...occurred},relationships:[]};
   for(const [field,value] of Object.entries(option.commitments||{})){
    const prior=ledger[field],domain=context.model.commitmentDomains[field];
    if(prior!==undefined&&prior!==value){
     if(domain.oppositions?.some(pair=>pair.includes(prior)&&pair.includes(value))){
      const change={field,from:prior,to:value,at:events.length,evidenceAvailable:step.before};changes.push(change);event.relationships.push('genuine_revision');
     }else {event.relationships.push('unresolved_relationship');unresolved.push({field,from:prior,to:value});}
    }else if(prior===value)event.relationships.push('compatible_continuation');
    ledger[field]=value;
   }
   if(!Object.keys(option.commitments||{}).length)event.relationships.push('action_succession');
   events.push(event);
  }
  structure.semanticEvents=events;structure.semanticRevisions=changes;structure.occurred=occurred;
  if(changes.length)add('revision','You explicitly changed a commitment; this does not establish that the earlier decision was mistaken.','necessary',{changes,events});
  if(structure.locked.length)add('closure','An earlier act closed alternatives; editing the scenario does not make that act reversible within it.','necessary',{locked:structure.locked});
  if(structure.known.length>(context.model.initial||[]).length)add('information','Later information changes the basis for another decision without proving the earlier decision mistaken.','necessary',{steps:structure.steps});
  const control=context.model.agency;
  if(control?.external&&control?.own)add('agency',`You chose to ${events.map(e=>e.action.toLowerCase()).join(', then ')}; ${control.external} remains outside those choices.`, 'conditional',{action:last.label,own:control.own,external:control.external,events});
  const assentChanges=changes.filter(c=>c.field===context.model.assentField);
  const assentDeclarations=structure.steps.filter(step=>Object.hasOwn(context.model.nodes[step.node].options.find(o=>o.id===step.choice).commitments||{},context.model.assentField));
  if(context.model.assentField&&Object.hasOwn(ledger,context.model.assentField)&&!unresolved.some(c=>c.field===context.model.assentField))add('assent',`You chose to ${assentDeclarations.map(step=>step.label.toLowerCase()).join(', then ')}. ${assentDeclarations.length===1?'This states your position; it does not settle the claim.':assentChanges.length?'This changes your stated position; it does not prove the claim false.':'Your stated position remained the same.'}`,'necessary',{commitments:ledger,changes:assentChanges,events,position:ledger[context.model.assentField]});
  add('uncertainty','An unchosen route remains a possibility, not an observed outcome.','conditional',{steps:structure.steps});

 }
 if(trade&&context.model.metric?.op==='minimum')add('dependency',`The arrangement completes ${structure.measure} ${structure.measure===1?(context.model.metric.singular||context.model.metric.unit):context.model.metric.unit}; completion depends on all required stages.${structure.alternatives.some(a=>a.delta>0)?' Moving one assignment can raise completion to '+structure.alternatives.find(a=>a.delta>0).measure+' without adding resources.':''}`, 'conditional',{measure:structure.measure,components:input.amounts.map((n,i)=>n*context.model.metric.weights[i]),alternative:structure.alternatives.find(a=>a.delta>0)||null});
 const contract=context.semantic.selection;
 if(!contract?.central?.length)return reject('No source-sensitive meaning warrant supplied.');
 if(transition&&!contract.changeCentral?.length)return reject('The changed condition lacks a source-authored philosophical warrant.');
 const centralKinds=transition?contract.changeCentral:contract.central;
 const selectionTrace=claims.map(c=>({kind:c.kind,sourceFidelityProvenance:'curated source contract, not independently proved',sourceFidelity:centralKinds.includes(c.kind)?'central':contract.alternatives?.includes(c.kind)?'secondary':'observation_only',pathRelevant:Object.keys(c.evidence).length>0,evidentialWarrant:c.classification!=='unsupported',conceptualRelationship:context.semantic.relation,educationalPurpose:contract.purpose,uncertainty:c.assumptions}));
 const eligible=claims.filter(c=>centralKinds.includes(c.kind)&&Object.keys(c.evidence).length);
 const secondary=claims.filter(c=>contract.alternatives?.includes(c.kind)&&Object.keys(c.evidence).length);
 const candidates=eligible.length?eligible:secondary;
 if(candidates.length!==1)return reject(candidates.length?'Several source-relevant meanings require editorial disambiguation.':'No source-relevant consequence is warranted.');
 const meaning=candidates[0];
 if(!meaning)return reject('No justified philosophical tension detected.');
 return {version:'meaning/1.2',status:'ready',quote:context.quote,author:context.author,source:context.source,semantic:context.semantic,structure,claims,meaning,selectionTrace,limitations:[context.semantic.boundary],assumptions:context.assumptions||[]};
}
const frames={reflective:'Consider the distinction.',surprising:'Notice what changes.',playful:'Turn the situation around.',challenging:'Test the distinction carefully.'};
const questions={transition:'Which part of the difference came from the changed conditions, and which part from your own revised choice?',intention_gap:'What would need to change for the allocation to meet the intention?',revision:'What could you reasonably have known before the later evidence arrived?',complementarity:'Which dependency makes the alternative possible?',closure:'Which earlier commitment limited the later alternatives?',information:'What changes when you separate earlier reasons from later knowledge?',conversion:'What becomes visible when the same choice is described in another measure?',repetition:'What would repeating this arrangement preserve or crowd out?',opportunity:'Which competing claim would bear the cost of a change?',uncertainty:'What remains unsettled after you have chosen?'};
function expressSemantic(packet,mode='reflective'){
 if(packet?.version!=='meaning/1.2'||packet.status!=='ready'||!packet.claims.includes(packet.meaning)||!frames[mode])return null;
 const m=packet.meaning;
 if(!['necessary','conditional'].includes(m.classification))return null;
 const headline=m.classification==='conditional'?'Under the scenario assumptions, '+m.text[0].toLowerCase()+m.text.slice(1):m.text;
 const concepts=packet.semantic.concepts;
 const evidence=m.evidence;
 const anchor={conversion:`${evidence.measure} ${evidence.unit}`,dependency:`${evidence.measure} completed ${evidence.measure===1?'unit':'units'}`,agency:evidence.external,assent:`your decision to ${evidence.events?.at(-1)?.action.toLowerCase()}`,revision:'the explicitly changed commitment'}[m.kind]||'this consequence';
 const relationship=packet.semantic.relation;
 const compositions={
  reflective:{experience:`The distinction is between ${concepts.join(' and ')}.`,interpretation:`${packet.author} brings into view ${relationship}.`,question:`When you consider ${anchor}, what becomes visible about ${concepts[1]} through ${concepts[0]}?`},
  surprising:{experience:`The same decision can be read through ${concepts[1]}, as well as ${concepts[0]}.`,interpretation:`What ${packet.author} makes visible here is ${relationship}.`,question:`Does describing ${anchor} through ${concepts[1]} change what you notice?`},
  playful:{experience:`Try reading ${concepts[0]} through the lens of ${concepts[1]}.`,interpretation:`That shift opens ${packet.author}’s question of ${relationship}.`,question:`Keep ${anchor} in view: what changes when you switch those lenses?`},
  challenging:{experience:`A distinction remains: ${concepts[0]} and ${concepts[1]} are not interchangeable.`,interpretation:`${packet.author} asks us to examine ${relationship}.`,question:`What would you overlook about ${anchor} if you considered only ${concepts[0]}?`}
 };
 const composed=compositions[mode];
 const experience=composed.experience;
 const interpretation=composed.interpretation+' '+packet.assumptions.join(' ')+' '+packet.limitations.join(' ');
 const proactiveQuestion=composed.question;
 const text=[headline,experience,interpretation,proactiveQuestion].join(' ');
 const wordCount=text.split(/\s+/).length;
 // Never truncate a caveat or silently add padding to satisfy a length target.
 if(wordCount>160)return {status:'needs_editorial_review',wordCount,reason:'Reading exceeds the safety ceiling; editorial shortening is required.'};
 return {status:'ready',mode,headline,experience,interpretation,proactiveQuestion,wordCount,evidence:m.evidence,classification:m.classification};
}


/* EXACT RESEARCH MODULE: philosophy-engine/encounter/reasoning-kernel-v11.js */
// All numerical inputs use discrete units declared by the scenario.
const natural=n=>Number.isSafeInteger(n)&&n>=0;
const unique=items=>new Set(items).size===items.length;
const declined=reason=>({version:"reasoning/1.1",status:"unsupported",classification:"unsupported",reason});

function mechanismFit(context,mechanism=context?.mechanism){
 if(!context?.source?.url || !context.quote || !context.author || !context.relation || !context.limit ||
    !context.operations?.includes(mechanism))return {status:"unsupported",reason:"Missing source or mechanism warrant."};
 if(mechanism!==context.mechanism)return {status:"unsupported",reason:"Scenario model does not supply this mechanism."};
 const s=context.model;
 const allowedOps={tradeoff:["conversion","complementarity","scarcity"],decision_map:["agency","information","path_dependence"]};
 if(!allowedOps[mechanism]?.includes(context.operation))return {status:"unsupported",reason:"Context has no supported structural operation."};
 if(mechanism==="tradeoff"){
  if(!Array.isArray(s?.choices) || !s.choices.length || !Array.isArray(s.resources) || !s.resources.length || s.choices.some(c=>!c)||s.resources.some(r=>!r)||!unique(s.choices.map(c=>c.id)) || !unique(s.resources.map(r=>r.id)) ||
     !s.choices.every(c=>c&&natural(c.max)&&c.max>0&&c.cost?.length===s.resources.length&&c.cost.every(natural)&&c.cost.some(Boolean)) ||
     !s.resources.every(r=>r&&natural(r.min)&&natural(r.max)&&r.min<=r.max&&["exact","cap"].includes(r.type)&&s.choices.some(c=>c.cost[s.resources.indexOf(r)]>0)) ||
     !s.resources.some((r,i)=>s.choices.filter(c=>c.cost[i]>0).length>=2 && s.choices.reduce((n,c)=>n+c.max*c.cost[i],0)>r.min))
    return {status:"unsupported",reason:"No valid shared scarcity constraint."};
  if(context.operation==="conversion"&&s.metric?.op!=="sum" || context.operation==="complementarity"&&
     (s.metric?.op!=="minimum" || s.metric.weights?.filter(w=>w>0).length<2))return {status:"unsupported",reason:"Scenario lacks the required cost or joint-output relation."};
  if(s.metric && (!["sum","minimum"].includes(s.metric.op)||s.metric.weights?.length!==s.choices.length||!s.metric.weights.every(natural)||!s.metric.weights.some(Boolean)))return {status:"unsupported",reason:"Invalid consequence measure."};
 }else if(mechanism==="decision_map"){
  if(!s?.nodes || !Object.hasOwn(s.nodes,s.start) || !Object.values(s.nodes).every(n=>n&&Array.isArray(n.options)&&n.options.length>0&&n.options.every(o=>o&&typeof o.id==="string"&&typeof o.label==="string"&&["requires","closes","reveal"].every(k=>o[k]===undefined||Array.isArray(o[k])&&o[k].every(v=>typeof v==="string")))&&unique(n.options.map(o=>o.id))&&n.options.every(o=>o.next===null||Object.hasOwn(s.nodes,o.next))))return {status:"unsupported",reason:"Incomplete decision structure."};
  const seen=new Set(),open=new Set();
  function acyclic(id){
   if(id===null||seen.has(id))return true;
   if(open.has(id))return false;
   open.add(id);
   if(!s.nodes[id].options.every(o=>acyclic(o.next)))return false;
   open.delete(id);seen.add(id);return true;
  }
  if(!acyclic(s.start)||![...seen].some(id=>s.nodes[id].options.length>1))return {status:"unsupported",reason:"A finite branching route is required."};
  if(context.operation==="information" && !Object.values(s.nodes).some(n=>n.options.some(o=>o.reveal?.length)))return {status:"unsupported",reason:"No change in available evidence."};
 }else return {status:"unsupported",reason:"No supported reasoning operation."};
 return {status:context.assumptions?.length?"conditional":"applicable",assumptions:context.assumptions||[]};
}

function allocationFacts(model,amounts,budgets){
 if(!Array.isArray(amounts)||amounts.length!==model.choices.length||!Array.isArray(budgets)||budgets.length!==model.resources.length||
    !Array.from(amounts).every((n,i)=>natural(n)&&n<=model.choices[i].max)||
    !Array.from(budgets).every((n,i)=>natural(n)&&n>=model.resources[i].min&&n<=model.resources[i].max)) return null;
 const spent=budgets.map((_,i)=>amounts.reduce((n,q,j)=>n+q*model.choices[j].cost[i],0));
 const slack=budgets.map((n,i)=>n-spent[i]);
 if(slack.some((n,i)=>n<0 || model.resources[i].type==="exact"&&n!==0))return null;
 const metric=model.metric;
 const components=metric?amounts.map((n,i)=>n*metric.weights[i]).filter((_,i)=>metric.weights[i]>0):[];
 return {spent,slack,measure:metric?(metric.op==="minimum"?Math.min(...components):components.reduce((a,b)=>a+b,0)):null};
}

function tradeoffStructure(model,input){
 const current=allocationFacts(model,input?.amounts,input?.budgets);
 if(!current)return null;
 const alternatives=[];
 // Compare one additional choice with either spare capacity or one unit
 // released elsewhere. Never treat an infeasible alternative as available.
 for(let add=0;add<model.choices.length;add++)for(let remove=-1;remove<model.choices.length;remove++){
  if(remove===add)continue;
  const next=input.amounts.slice();next[add]++;if(remove>=0)next[remove]--;
  const fact=allocationFacts(model,next,input.budgets);
  if(fact)alternatives.push({add,remove,amounts:next,measure:fact.measure,delta:fact.measure===null?null:fact.measure-current.measure});
 }
 return {...current,amounts:[...input.amounts],budgets:[...input.budgets],alternatives};
}

function decisionStructure(model,path){
 if(!Array.isArray(path))return null;
 let at=model.start;
 const commitments={},revisions=[];
 const known=new Set(model.initial||[]),locked=new Set(),steps=[],visited=new Set();
 for(const id of path){
  if(at===null||!Object.hasOwn(model.nodes,at)||visited.has(at))return null;
  visited.add(at);
  const node=model.nodes[at];
  const available=node.options.filter(o=>(o.requires||[]).every(k=>known.has(k))&&!locked.has(o.id));
  const option=available.find(o=>o.id===id);
  if(!option)return null;
  steps.push({node:at,choice:id,label:option.label,before:[...known],revealed:option.reveal||[],
    alternatives:available.filter(o=>o!==option).map(o=>o.label),closed:option.closes||[]});
  for(const [field,value] of Object.entries(option.sets||{})){
   if(Object.hasOwn(commitments,field)&&commitments[field]!==value)revisions.push({field,from:commitments[field],to:value});
   commitments[field]=value;
  }
  for(const k of option.reveal||[])known.add(k);
  for(const k of option.closes||[])locked.add(k);
  at=option.next;
 }
 if(at!==null&&visited.has(at))return null;
 const available=at===null?[]:model.nodes[at].options.filter(o=>(o.requires||[]).every(k=>known.has(k))&&!locked.has(o.id));
 return {steps,commitments,revisions,known:[...known],locked:[...locked],at,available};
}

function evaluateKernel(context,input){
 const fit=mechanismFit(context);
 if(fit.status==="unsupported")return declined(fit.reason);
 const allocation=context.mechanism==="tradeoff";
 const structure=allocation?tradeoffStructure(context.model,input):decisionStructure(context.model,input?.path);
 if(!structure || !allocation&&(structure.at!==null||!structure.steps.length))return declined("The choices are incomplete or incompatible with this scenario.");
 let observed,discovery,condition,headline,question=context.question;
 if(allocation){
  const m=context.model,unit=m.metric?.unit;
  const named=(n,c)=>n+" "+(n===1&&c.singular?c.singular:c.label);
  const measured=n=>n+" "+(n===1&&m.metric?.singular?m.metric.singular:unit);
  const amounts=m.choices.map((c,i)=>named(input.amounts[i],c));
  observed="You chose "+(amounts.length>1?amounts.slice(0,-1).join(", ")+" and "+amounts.at(-1):amounts[0])+".";
  const better=structure.alternatives.reduce((best,a)=>a.delta>0&&(!best||a.delta>best.delta)?a:best,null);
  const next=(m.metric?.op==="minimum"&&better)||structure.alternatives.find(a=>a.remove===-1)||structure.alternatives[0];
  if(next){
   const gain=m.choices[next.add],released=m.choices[next.remove];
   const exchange=released?"exchanged one "+(released.singular||"unit of "+released.label)+" for one "+(gain.singular||"unit of "+gain.label):
    "added one "+(gain.singular||"unit of "+gain.label)+" from the unused budget";
   condition="If you "+exchange+", "+(unit?"the total would be "+measured(next.measure):"the arrangement would still fit")+".";
  }
  discovery=structure.measure===null?"The unused capacity is "+structure.slack.join(", ")+".":"That works out to "+measured(structure.measure)+" under the scenario’s assumptions.";
  if(m.metric?.op==="minimum")headline=better&&better.remove>=0?"One more "+(m.choices[better.add].singular||"unit here")+" could change what the whole group finishes.":
    "What can be finished depends on the least supplied step.";
  else if(m.metric?.op==="sum")headline=structure.measure?"What you chose would cost "+measured(structure.measure)+".":"An unused budget leaves its underlying cost unclaimed.";
  else headline=structure.slack.every(n=>n===0)?"Another claim would need room from somewhere.":"There is still room before another choice has to give way.";
  if(m.metric?.op==="minimum" && better)question=context.questions?.gain||question;
  if(m.metric?.op==="sum" && structure.measure===0)question=context.questions?.zero||question;
 }else{
  const lowerFirst=t=>t[0].toLowerCase()+t.slice(1);
  const actions=structure.steps.map(s=>lowerFirst(s.label));
  observed="You chose to "+actions.join(", then ")+".";

  const last=structure.steps.at(-1);

  condition=last.alternatives.length?"Another option still open then was to "+lowerFirst(last.alternatives[0])+".":null;
  const evidence=last.before.at(-1);
  discovery=evidence?"At that moment, "+lowerFirst(evidence)+".":"No further evidence had arrived.";
  if(last.revealed.length)discovery+=" Only afterward did you learn the result: "+lowerFirst(last.revealed.at(-1))+".";
  headline=structure.revisions.length?"You revised a commitment while it was still yours to change.":
    context.operation==="agency"&&context.control?context.control.action+" was your decision. The verdict belonged elsewhere.":
    last.before.length>(context.model.initial||[]).length?"You made the later choice with evidence the earlier one lacked.":
    last.revealed.length?"The consequence became visible after the choice.":"You could decide what to do while the claim itself stayed unsettled.";
  if(structure.revisions.length)question=context.questions?.revision||question;


 }
 const claims=[{classification:"necessary",text:observed,basis:"validated selections"},
   {classification:fit.assumptions.length?"conditional":"necessary",text:discovery,basis:"scenario model",assumptions:fit.assumptions},
   ...(condition?[{classification:"conditional",text:condition,basis:"feasible alternative",assumptions:[...fit.assumptions,"The alternative is chosen."]}]:[]),
   {classification:"unsupported",text:context.limit,basis:"outside scenario"}];
 claims.push({role:"discovery",classification:fit.assumptions.length?"conditional":"necessary",text:headline,basis:"evaluated structure",assumptions:fit.assumptions});
 claims.push({role:"interpretation",classification:"conditional",text:context.relation,basis:context.source.url,assumptions:[...fit.assumptions,"The curated analogy is accepted."]});
 return {version:"reasoning/1.1",status:"ready",quote:{id:context.id,text:context.quote,author:context.author,work:context.source.work},
  source:context.source,mechanism:context.mechanism,fit,structure,claims,distinction:context.distinction,
  headline,relation:context.relation,question,limitations:[context.limit],selections:allocation?{amounts:structure.amounts,budgets:structure.budgets}:{path:[...input.path]}};
}

// Translate the established pilots' existing configuration rather than copying
// their case-specific motive, historical, or quotation-return rules.
function pilotStructure(spec,result,input){
 const t=spec.family==="tradeoff";
 let model,selections;
 if(t){
  model={resources:[{id:"evening",min:6,max:6,type:"exact"}],choices:spec.categories.map((label,i)=>({id:i,label,max:6,cost:[1]}))};
  selections={amounts:input.ticks,budgets:[6]};
 }else{
  const nodes={};
  function expand(i,prior,name){
   const stage=spec.steps[i];
   const options=Array.isArray(stage.options)?stage.options:stage.options[prior];
   nodes[name]={prompt:stage.prompt,options:options.map(o=>{
    const next=i+1<spec.steps.length?name+"/"+o.id:null;
    if(next)expand(i+1,o.id,next);
    return {id:o.id,label:o.label,next,reveal:i===1?[o.label]:[]};
   })};
  }
  expand(0,null,"start");
  model={start:"start",nodes};selections={path:spec.steps.map(step=>input[step.key])};
 }
 const source=result.sourceReferences.find(s=>s.url?.startsWith("http"))||result.sourceReferences[0];
 return evaluateKernel({id:spec.id,quote:result.quote.text,author:spec.author,source:{...source,work:result.quote.work},
  model,operation:t?"scarcity":"path_dependence",operations:[spec.family],mechanism:spec.family,assumptions:["Within this imagined scenario."],relation:result.sourceRelation,
  distinction:result.sourceRelation,question:"Which condition makes this reading possible?",limit:spec.guard},selections);
}

// Fail closed at the expression boundary if claim status or its provenance
// has been lost while transporting a packet. Prose is emitted from claims.
function validateKernelPacket(packet){
 if(packet?.version!=="reasoning/1.1"||packet.status!=="ready"||!packet.source?.url||!packet.quote?.text||
   !Array.isArray(packet.claims)||!packet.claims.length||!packet.question)return false;
 if(!packet.claims.every(c=>c&&["necessary","conditional","unsupported"].includes(c.classification)&&c.basis&&
   typeof c.text==="string"&&c.text.length&&(c.classification!=="conditional"||Array.isArray(c.assumptions)&&c.assumptions.length>0)))return false;
 const backed=(role,text)=>packet.claims.some(c=>c.role===role&&c.classification!=="unsupported"&&c.text===text);
 return backed("discovery",packet.headline)&&backed("interpretation",packet.relation)&&
   packet.claims.some(c=>c.basis==="validated selections"&&c.classification==="necessary");
}


/* EXACT RESEARCH MODULE: philosophy-engine/encounter/encounter-distinction-v13.js */
// Each pair belongs to one validated distinction. The time line uses the
// actual allocation; the temporal pairs distinguish when evidence arrived.
const eveningPairs = {
  "planned-replies-majority":["Intended","Protect time for what matters.","Allocated","Replies receive most of the evening."],
  "obligations-visible-replies":["Reason given","Other things needed doing.","In this evening","Replies receive more time than writing."],
  "obligations-visible-rest":["Reason given","Other obligations still mattered.","In this evening","Rest receives the largest share."],
  "obligations-visible-writing":["Reason given","Other things needed doing.","In this evening","Writing receives one of the largest shares."],
  "interrupted-without-replies":["Demand","The phone still interrupts.","Allocation","No time is assigned to replying."],
  "chosen-rest":["Tonight","Rest gets the largest share.","If repeated","Rest would have a regular place."],
  "deliberate-pause":["Tonight","The story can wait.","If repeated","The promised writing session never arrives."],
  "requests-without-writing":["Tonight","Every hour is assigned.","If repeated","The story still has no session."],
  "exception-repeated":["This evening","No time goes to the story.","If repeated","The exception could become the routine."],
  "exclusive-evening":["One sitting","Writing fills the evening.","A routine","Rest and replies need time elsewhere."],
  "writing-sets-budget":["Time set aside","Writing gets most of the evening.","Boundary","Other claims share what remains."],
  "room-for-both":["In this plan","Writing and rest both fit.","An extra half-hour","Something else must give way."],
  "recurring-foothold":["Tonight","There is a writing session.","Still open","The next session has no guarantee."]
};
const routePairs = {
  "feeling-and-forecast":["Then","Distance was something to imagine.","Now","You miss your friends. Continuing is still a step into the unknown."],
  "new-reason-for-action":["Then","The move lay ahead.","Now","Distance gives you a reason to make a plan for your friendships."],
  "continuity-of-place":["Chosen","You could keep your job.","Outside your choice","You could not keep the team from changing."],
  "successive-decisions":["First decision","Stay with a familiar team.","Second decision","Give a changed team more time."],
  "reasons-and-alternatives":["Within reach","Your reasons for staying.","Beyond reach","Experience of the job you turned down."],
  "commitment-without-comparison":["Still unknown","What moving would have brought.","Within reach","What you give your attention to here."],
  "terms-open-to-revision":["At acceptance","The actual hours lay ahead.","At renegotiation","You know their cost in evenings."],
  "cost-of-learning":["To learn","See how the hours feel over time.","What it takes","Live through more of those evenings."]
};

function encounterDistinction(result, relation) {
  const kind=relation.kind;
  let pair;
  if (kind==="protected-or-remainder"){
    const minutes=relation.premises.writing*60;
    pair=["Allocated",minutes+" minutes for the story.","Protected","These minutes might have been reserved or left over."];
  } else {
    pair=(result.caseId==="dillard"?eveningPairs:routePairs)[kind];
  }
  if (!pair) return null;
  const [firstLabel,firstText,secondLabel,secondText]=pair;
  return {kind,form:result.caseId==="kierkegaard" && ["feeling-and-forecast","new-reason-for-action","successive-decisions","terms-open-to-revision"].includes(kind)?"sequence":"comparison",
    items:[{label:firstLabel,text:firstText},{label:secondLabel,text:secondText}]};
}

// Recognize complete, supported questions in volunteered fields. A word like
// "uncertain", a shared theme, or an app-generated prompt is insufficient.
// Keep the original words; matching a question gives no evidence of agreement.
const priorInquiries = {
  dillard:{
    pattern:/^(?:how (?:do|can) (?:i|we) (?:make|find|protect|set aside) time for (?:what matters(?: most)?|(?:my|our) priorities|writing)|(?:how )?(?:do|can) (?:my|our) (?:daily habits|routines) (?:reflect|shape) (?:what (?:i|we) value|(?:my|our) priorities))\?$/i,
    statement:/^I (?:keep meaning|intend|want) to (?:write|make time for what matters),? but (?:I (?:keep )?(?:end up answering messages|put it off)|other demands keep taking (?:over|my time))\.?$/i,
    connection:"Dillard offers a way to revisit that question by imagining tonight’s arrangement repeated."
  },
  kierkegaard:{
    pattern:/^(?:can (?:careful )?(?:reasoning|reflection|thinking(?: it through)?) (?:ever )?(?:remove|eliminate|resolve) (?:all )?uncertainty(?: before (?:i|we) (?:act|choose|decide))?|how (?:can|could) (?:i|we) know (?:the outcome|what will happen) before (?:i|we) (?:act|choose|decide))\?$/i,
    statement:/^I (?:wonder whether|wish I knew whether|keep asking whether) (?:careful )?(?:reasoning|reflection|thinking it through) (?:can|could) (?:ever )?(?:remove|eliminate|resolve) (?:all )?uncertainty(?: before (?:I|we) (?:act|choose|decide))?[.?]?$/i,
    connection:"Kierkegaard gives that question a limit: part of the evidence arrives through living the choice."
  }
};

// The authored phrase is evidence of a question, not agreement with its thesis.
// These are conservative, source-specific semantic gates: no remote embeddings,
// no model-generated memories, and no matching on themes/saves alone.
function relatedVolunteeredReflection(id, value, inquiry){
  const words=typeof value==="string"?value.trim():"";
  if(words.length<22 || words.length>240) return false;
  if(/^(?:my friend|a friend|someone|he|she|they|the article|the quote|the app|the philosopher|i read|imagine|suppose|for example)\b/i.test(words)) return false;
  if(/^i (?:do not|don't|never) (?:wonder|worry|ask|question)\b/i.test(words)) return false;
  if(!/^(?:i\b|i'm\b|i've\b|it feels like i\b|my\b|we\b|our\b|how\b|when\b|what\b|why\b|can\b|could\b|should\b|does\b|is\b)/i.test(words)) return false;
  if(inquiry.pattern.test(words) || inquiry.statement.test(words)) return true;
  if(id==="dillard"){
    const aboutMeaningfulPractice=/\b(?:writ(?:e|ing)|story|time for what matters|daily habits|routines?|priorit(?:y|ies)|things i care about)\b/i.test(words);
    const aboutRepeatedTime=/\b(?:time|hours?|days?|week|schedule|routine|messages?|repl(?:y|ies)|postpon(?:e|ing)|interrupt(?:ion|ed|ions?)|distract(?:ion|ed|ions?)|demands?)\b/i.test(words);
    return aboutMeaningfulPractice && aboutRepeatedTime;
  }
  if(id==="kierkegaard"){
    const aboutChoice=/\b(?:decid(?:e|es|ed|ing)|decisions?|choos(?:e|ing)|choices?|act(?:ing)?|commit(?:ting|ment)?|keep going|moving|stay(?:ing)?)\b/i.test(words);
    const aboutKnowledgeInTime=/\b(?:uncertain(?:ty)?|unknown|unsure|not know|don't know|cannot know|predict(?:ion)?|future|before|after|later|regret(?:ting)?|outcome|hindsight|certainty|know what|what will happen)\b/i.test(words);
    return aboutChoice && aboutKnowledgeInTime;
  }
  return false;
}

function encounterWorldThread(memory,id){
  const inquiry=priorInquiries[id];
  if (!inquiry || !Array.isArray(memory?.threads)) return null;
  for(const record of [...memory.threads].reverse()){
    if(record?.type!=="thread" || !record.id || !Number.isInteger(record.quoteId)) continue;
    for(const field of ["note","opening"]){
      const words=record[field];
      if(!relatedVolunteeredReflection(id,words,inquiry)) continue;
      const fixture=memory.fixture===true;
      return {source:"livingThreads.history",recordId:record.id,field,quoteId:record.quoteId,date:record.date||null,
        fixture,excerpt:words.trim(),interpretation:inquiry.connection,
        text:(fixture?"In this sample reflection":"You previously wrote")+": “"+words.trim().slice(0,110)+(words.trim().length>110?"…":"")+"” "+inquiry.connection};
    }
  }
  return null;
}


