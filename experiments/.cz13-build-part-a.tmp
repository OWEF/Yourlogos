/* EXACT RESEARCH MODULE: philosophy-engine/context-atlas/grammar-v01.js */
/**
 * CZ-110: Four-layer philosophical grammar and cautious mechanic assessment.
 * This module maps CURATED interpretations, not quote keywords, to tentative
 * interactions. It cannot prove an author's intended meaning or find truth.
 * No LLM, network, database, personal profiles, or runtime publication.
 */

const CONTEXT_ATLAS_SCHEMA_VERSION = 1;
const mechanics = Object.freeze({
  tradeoff: "source_grounded_constraint",
  decision_map: "branch_dependency",
  counterexample: "generalization_scope",
});
const nonEmpty = v => typeof v === "string" && v.trim().length > 0;
const object = v => v !== null && typeof v === "object" && !Array.isArray(v);
const quantities = ["universal","particular","singular","generic","unspecified"];
const qualities = ["affirmative","negative","mixed","figurative","not_classifiable"];
const relations = ["categorical","hypothetical","disjunctive","mixed","not_classifiable"];
const modalities = ["problematic","assertoric","apodictic","figurative","unspecified","not_classifiable"];
const requireText = (value, name, errors) => {if (!nonEmpty(value)) errors.push(name+" must be nonempty");};

function validateContextRecord(r) {
  const errors = [];
  if (!object(r)) return ["record must be an object"];
  if (!Number.isInteger(r.id)||r.id<0) errors.push("invalid quote id");
  requireText(r.quote?.text,"quote text",errors);
  requireText(r.quote?.author,"quote author",errors);
  requireText(r.quote?.bundledSource,"quote work",errors);
  if (!["catalogue_only","passage_location_checked","paraphrase_context_checked"].includes(r.quote?.provenanceStatus))
    errors.push("invalid quote provenance status");
  const p=r.sourcePassage;
  requireText(p?.work,"source passage work",errors);
  requireText(p?.contextualSummary,"passage context",errors);
  if (!Array.isArray(p?.references)||!p.references.some(x=>x.kind==="internal_bundled_catalogue"&&x.url==="app.js"))
    errors.push("must retain quote identity reference to bundled catalogue");
  for (const ref of p?.references||[]) {
    if (!nonEmpty(ref.url)||!nonEmpty(ref.supports)||!nonEmpty(ref.kind))
      errors.push("incomplete provenance reference");
    if (ref.url!=="app.js"&&!/^https:\/\//.test(ref.url))
      errors.push("external references must use https");
  }
  if (p?.contextStatus==="passage_linked_editorial_summary" &&
      !p.references.some(x=>x.url!=="app.js"))
    errors.push("passage linked without an external reference");
  requireText(r.authorPosition?.scopedSummary,"author position",errors);
  requireText(r.authorPosition?.periodOrWork,"position period/work",errors);
  if (!Array.isArray(r.authorPosition?.tradition)||!r.authorPosition.tradition.length||
    r.authorPosition.tradition.some(s=>!nonEmpty(s)))
    errors.push("tradition must be nonempty array");
  const a=r.argumentModel, f=a?.logicalForm;
  for (const key of ["claim","warrant","relation","scopeOrConditions","challenge","limits"]) requireText(a?.[key],"argument "+key,errors);
  if (!Array.isArray(a?.concepts)||a.concepts.length<2||new Set(a.concepts).size!==a.concepts.length)
    errors.push("concept list must contain at least two distinct nodes");
  if (!Array.isArray(a?.alternativeReadings)||a.alternativeReadings.length<2||a.alternativeReadings.some(x=>!nonEmpty(x)))
    errors.push("at least two plausible readings must be preserved");
  for (const [name,allowed] of [["quantity",quantities],["quality",qualities],["relation",relations],["modality",modalities]])
    if (!allowed.includes(f?.[name])) errors.push("unsupported logical form "+name);
  if(f?.interpretationNotLogicalProof!==true||!nonEmpty(f?.note))errors.push("logical classification must declare tentative reading");
  for (const key of ["name","task","target"]) requireText(r.philosophicalOperation?.[key],"operation "+key,errors);

  const i=r.interactionModel;
  if (!Object.keys(mechanics).concat("none").includes(i?.candidate))
    errors.push("unsupported candidate mechanic");
  if (i?.candidate==="none") {
    if(i.eligibility!=="none_suitable"||i.mechanismProof!==null||i.scenario!==null) errors.push("none-suitable must have no fabricated mechanic");
  } else {
    if(i?.eligibility!=="conditional"||i.mechanismProof?.kind!==mechanics[i.candidate]||
       !nonEmpty(i.mechanismProof?.ground)||!nonEmpty(i.mechanismProof?.requires)||
       !nonEmpty(i.scenario))
      errors.push("candidate lacks source-related operation proof");
  }
  requireText(i?.fitnessReason,"mechanic fitness",errors);
  requireText(i?.blocker,"mechanic blocker",errors);
  if (!Array.isArray(i?.contraindicatedScenarioIds)||
      i.contraindicatedScenarioIds.some(x=>!nonEmpty(x)))
    errors.push("invalid contraindicated scenario IDs");
  if (i?.approval!=="not_approved") errors.push("pilot cannot claim mechanic approval");
  if (r.review?.status!=="draft"||r.review?.scholarlyReviewed!==false||r.review?.publisherApproved!==false)
    errors.push("pilot may not be marked verified/published");
  return errors;
}

function evaluatePhilosophicalGrammar(r) {
  const errors=validateContextRecord(r);
  if(errors.length) throw new TypeError(errors.join("; "));
  const candidate=r.interactionModel.candidate;
  const hasExternalPassage = r.sourcePassage.references.some(x=>x.url!=="app.js");
  const eligibility = candidate==="none" ? "abstain_no_suitable_mechanic" :
    !hasExternalPassage ? "candidate_source_review_required" :
    "candidate_editorial_review_required";
  return {
    quoteId:r.id,
    version:CONTEXT_ATLAS_SCHEMA_VERSION,
    epistemicStatus:"editorial_hypothesis",
    sourceContext:{
      work:r.sourcePassage.work,
      passage:r.sourcePassage.locator,
      evidenceType:r.sourcePassage.contextStatus,
      interpretationStatus:r.review.status,
      authorPositionScope:r.authorPosition.periodOrWork,
    },
    logicalForm:{...r.argumentModel.logicalForm},
    conceptualStructure:{
      claim:r.argumentModel.claim,
      warrant:r.argumentModel.warrant,
      concepts:r.argumentModel.concepts,
      relation:r.argumentModel.relation,
      scope:r.argumentModel.scopeOrConditions,
      alternatives:r.argumentModel.alternativeReadings,
      challenge:r.argumentModel.challenge,
      boundaries:r.argumentModel.limits,
    },
    philosophicalOperation:{...r.philosophicalOperation},
    interactiveRealization:{
      candidate,eligibility,
      epistemicStatus:"unapproved_suggestion",
      proof:r.interactionModel.mechanismProof,
      proposedScenario:r.interactionModel.scenario,
      risks:r.interactionModel.blocker,
      scenarioExclusions:r.interactionModel.contraindicatedScenarioIds,
      allowedForProduction:false,
    },
    trace:[
      {layer:"quote",reason:"Identity tracked to bundled quotation "+r.id},
      {layer:"source_context",reason:r.sourcePassage.contextStatus},
      {layer:"form",reason:r.argumentModel.logicalForm.note},
      {layer:"conceptual_structure",reason:r.argumentModel.warrant},
      {layer:"operation",reason:r.philosophicalOperation.task},
      {layer:"realization",reason:r.interactionModel.fitnessReason},
    ],
  };
}

/**
 * Bridge audit against the existing REAL CZ-105 Trade-Off reasoner.
 * The test can reject an existing scenario despite a potential fit between
 * its philosopher and the abstract Trade-Off operation.
 */
function auditLegacyReasoningResult(r, result, scenarioId) {
  const grammar=evaluatePhilosophicalGrammar(r);
  if (result?.model?.quoteId!==r.id) throw new TypeError("Quote identity mismatch between atlas and reasoner");
  if (result?.mechanism!=="tradeoff") throw new TypeError("Unsupported mechanism for existing CZ-105 audit");
  const reasons=[];
  if(grammar.interactiveRealization.candidate!=="tradeoff") reasons.push("Quote has not been fitted to Trade-Off");
  if(grammar.interactiveRealization.scenarioExclusions.includes(scenarioId))
    reasons.push("Scenario is a teaching invention that does not test the source's central relationship");
  if(result.model.productionEligible!==true)
    reasons.push("Existing philosophical model is not source-approved for production");
  if(r.review.publisherApproved!==true)
    reasons.push("Context Atlas record has not received editorial approval");
  return {
    quoteId:r.id,
    outcome: reasons.length?"blocked_for_public_expression":"eligible_for_later_expression_review",
    observedDecision:result.what_happened.summary,
    necessaryFindings:result.what_follows.necessary.map(f=>f.statement),
    conditionalFindings:result.what_follows.possible.map(f=>f.statement),
    candidateDiscovery:grammar.conceptualStructure.claim,
    candidateJustification:grammar.conceptualStructure.warrant,
    uncertainty:result.what_remains_uncertain.map(u=>u.question),
    proposedTension:result.what_follows.tensions.map(t=>t.statement),
    trace:{atlas:grammar.trace,engine:result.why_this.rule_trace},
    blockers:reasons,
    readyForExpression:reasons.length===0,
    philosophicalTruthClaim:false,
  };
}

function summarizeAtlasPilot(records=ATLAS_PILOT_V01){
 const results=records.map(evaluatePhilosophicalGrammar);
 const candidateCounts=Object.fromEntries(["tradeoff","decision_map","counterexample","none"].map(
   m=>[m,results.filter(r=>r.interactiveRealization.candidate===m).length]));
 return {
   count:results.length,
   candidates:candidateCounts,
   readyForProduction:results.filter(r=>r.interactiveRealization.allowedForProduction).length,
   sourceLinked:results.filter(r=>r.sourceContext.evidenceType==="passage_linked_editorial_summary").length,
   notSuitable:results.filter(r=>r.interactiveRealization.eligibility==="abstain_no_suitable_mechanic").map(r=>r.quoteId),
   concerns:results.filter(r=>r.interactiveRealization.scenarioExclusions.length).map(r=>({id:r.quoteId,excluded:r.interactiveRealization.scenarioExclusions})),
 };
}


/* EXACT RESEARCH MODULE: philosophy-engine/encounter/insight-packet-v01.js */
/**
 * CZ-111 Insight Packet v0.1: shared contract between source-grounded
 * philosophical reasoning and surface expression. It is not a truth verdict.
 */
const INSIGHT_PACKET_VERSION = 1;
const MAX_COPY = Object.freeze({headline:100,observation:190,discovery:230,connection:220,question:190});

function assertText(value, label, limit=2500) {
  if (typeof value !== "string" || !value.trim() || value.length > limit)
    throw new TypeError(label + " must be nonempty and <= " + limit + " characters");
}
function validateInsightPacket(packet) {
  const errors=[];
  try {
    if (packet?.schemaVersion !== INSIGHT_PACKET_VERSION) throw Error("schema version mismatch");
    if (![49,28].includes(packet.quote?.id)) throw Error("unknown pilot quote ID");
    if (!["tradeoff","decision_map"].includes(packet.mechanism)) throw Error("unknown mechanism");
    assertText(packet.scenarioId,"scenarioId");
    assertText(packet.quote?.text,"source quotation");
    assertText(packet.quote?.author,"author");
    assertText(packet.quote?.source,"work");
    assertText(packet.observation?.text,"observation",MAX_COPY.observation);
    assertText(packet.insight?.headline,"headline",MAX_COPY.headline);
    assertText(packet.insight?.discovery,"discovery",MAX_COPY.discovery);
    assertText(packet.insight?.connection,"connection",MAX_COPY.connection);
    assertText(packet.insight?.question,"question",MAX_COPY.question);
    assertText(packet.insight?.limit,"epistemic limit");
    assertText(packet.insight?.ruleId,"inference rule ID");
    assertText(packet.insight?.conceptualRelation,"source-grounded relation");
    if (!Array.isArray(packet.trace?.rules)||packet.trace.rules.length===0 ||
       packet.trace.rules.some(s=>typeof s!=="string"||!s.trim())) throw Error("missing fired rule trace");
    if (!Array.isArray(packet.trace?.sourceReferences)||!packet.trace.sourceReferences.length)
      throw Error("missing source trace");
    if (packet.flags?.truthVerdict!==false||packet.flags?.productionEligible!==false ||
       packet.flags?.editorialStatus!=="draft") throw Error("pilot must be clearly non-authoritative");
    if (packet.visual?.type==="segments") {
      const values=packet.visual.values;
      if(!Array.isArray(values)||values.length!==3||values.some(n=>!Number.isFinite(n)||n<0)||
         values.reduce((a,b)=>a+b,0)!==3)throw Error("invalid three-hour segment visual");
    } else if (packet.visual?.type==="path") {
      if(!Array.isArray(packet.visual.nodes)||packet.visual.nodes.length!==3)
        throw Error("invalid three-node path");
    } else throw Error("unsupported visual");
  } catch (e) {errors.push(e.message);}
  return errors;
}
function createInsightPacket(fields) {
  const packet={
    schemaVersion: INSIGHT_PACKET_VERSION,
    ...fields,
    flags:{truthVerdict:false,productionEligible:false,editorialStatus:"draft"}
  };
  const errors=validateInsightPacket(packet);
  if(errors.length)throw new TypeError(errors.join("; "));
  return packet;
}


/* EXACT RESEARCH MODULE: philosophy-engine/encounter/experience-reasoners-v01.js */
/**
 * CZ-111: pilot-specific but shared-contract philosophical reasoners.
 * Independent of presentation and usable for meaningful input variation tests.
 * They consume the actual CZ-110 Context Atlas. The old CZ-105 8h reasoner is
 * deliberately not silently reused for a different, 3h exercise.
 */



const categories=["Optional work","A friend","Quiet reflection"];
const resource={income:"financial security",space:"private working space",access:"access to education and publishers"};
const barrier={income:"financial insecurity",space:"interruptions and fragile privacy",access:"institutional exclusion"};
const response={write:"start writing despite constraints",protect:"try to protect ongoing time",challenge:"challenge a structural barrier"};
const isValidChoice=(v,o)=>Object.hasOwn(o,v);
const h=n=>(Number.isInteger(n)?String(n):String(n))+"h";
const getContext=(id,mechanism)=>{
  const record=ATLAS_PILOT_V01.find(r=>r.id===id);
  if(!record)throw new RangeError("Missing philosophical context "+id);
  const grammar=evaluatePhilosophicalGrammar(record);
  if(grammar.interactiveRealization.candidate!==mechanism ||
     grammar.interactiveRealization.allowedForProduction!==false)
    throw Error("Mechanic is not a permitted provisional research candidate");
  return {record,grammar};
};
const provenance=(r)=>r.sourcePassage.references.map(x=>({
  kind:x.kind,uri:x.url,supports:x.supports
}));

function reallocateEvening(ticks, selectedIndex, desiredTicks){
 if(!Array.isArray(ticks)||ticks.length!==3||ticks.some(n=>!Number.isInteger(n)||n<0||n>6)||
    ticks.reduce((a,b)=>a+b,0)!==6)throw new TypeError("Expected three-hour allocation in half-hour ticks");
 if(!Number.isInteger(selectedIndex)||selectedIndex<0||selectedIndex>2||
    !Number.isInteger(desiredTicks)||desiredTicks<0||desiredTicks>6)
    throw new RangeError("Invalid slider");
 if(ticks[selectedIndex]===desiredTicks)return [...ticks];
 const other=[0,1,2].filter(i=>i!==selectedIndex),remaining=6-desiredTicks;
 const previous=ticks[other[0]]+ticks[other[1]];
 const first=previous===0?Math.round(remaining/2):Math.round(remaining*ticks[other[0]]/previous);
 const next=[0,0,0];
 next[selectedIndex]=desiredTicks;next[other[0]]=first;next[other[1]]=remaining-first;
 if(next.reduce((a,b)=>a+b,0)!==6)throw Error("Zero-sum invariant broken");
 return next;
}

function reasonSeneca(input){
 const {record,grammar}=getContext(49,"tradeoff");
 const ticks=input?.ticks,motivation=input?.motivation;
 if(!Array.isArray(ticks)||ticks.length!==3||ticks.some(n=>!Number.isInteger(n)||n<0||n>6)||
    ticks.reduce((a,b)=>a+b,0)!==6)throw new TypeError("Three-hour fixed budget expected");
 if(!["chosen","expected","necessary"].includes(motivation))throw new TypeError("Select a valid motivation");
 const values=ticks.map(t=>t/2),max=Math.max(...values);
 const leaders=values.map((v,i)=>v===max?i:-1).filter(i=>i!==-1);
 const focus=leaders[0];
 const omissions=values.map((v,i)=>v===0?i:-1).filter(i=>i!==-1);
 const observed=categories.map((label,i)=>label+" "+h(values[i])).join(" · ");
 const dominant=leaders.length===1?categories[focus].toLowerCase():"more than one purpose";
 const other=values.map((v,i)=>({i,v})).filter(v=>v.i!==focus).sort((a,b)=>b.v-a.v)[0];
 const outcomeCode=max===3?"single_priority":leaders.length>1?"shared_priorities":"uneven_priorities";
 const pattern=outcomeCode==="single_priority"?"The whole evening went to "+categories[focus].toLowerCase()+".":
   outcomeCode==="shared_priorities"?"Your evening keeps several priorities in play.":
   "Most time went to "+dominant+"; "+categories[other.i].toLowerCase()+" received "+h(other.v)+".";
 const motive={
  chosen:"A freely chosen commitment can be deliberate even when it excludes something else.",
  expected:"An outside expectation can shape how you use free time, without proving the choice was wrong.",
  necessary:"A responsibility may be worthwhile even when it reduces the choices available tonight."
 }[motivation];
 const omitted=omissions.length?
   " No time remains tonight for "+omissions.map(i=>categories[i].toLowerCase()).join(" or ")+".":"";
 const observation=observed; // factual and exact
 const discovery=(pattern+" "+motive).slice(0,230);
 const connection=motivation==="expected"?
   "Seneca questions time consumed by unexamined demands. The issue is who directs the hour—not whether work is automatically wasted.":
   motivation==="necessary"?
   "Seneca's concern with deliberate living does not mean every duty is disposable. The question is what can genuinely be chosen.":
   "For Seneca, how time is used matters. A deliberate sacrifice can express a value; the numbers alone cannot decide if it was worthwhile.";
 const question=motivation==="expected"?"Which part of tonight's commitment would you still choose without anyone expecting it?":
   motivation==="necessary"?"Which part of the obligation is unavoidable, and which part might still be yours to decide?":
   max===3?"What made this one purpose worth excluding the others tonight?":
   "What would you change if one of these commitments mattered more tomorrow?";
 const headline=motivation==="expected"?"Your free time isn't always free from expectations.":
   motivation==="necessary"?"Not every obligation is a surrender.":
   outcomeCode==="single_priority"?"You chose one priority—and its cost.":
   outcomeCode==="shared_priorities"?"More than one priority can deserve your time.":"A choice reveals what else must wait.";
 return createInsightPacket({
  quote:{id:49,text:record.quote.text,author:record.quote.author,source:record.sourcePassage.work},
  mechanism:"tradeoff",scenarioId:"three-hour-discretionary-evening",
  observation:{text:observation,allocation:values,motivation},
  insight:{
    headline,discovery,connection,question,
    ruleId:"tradeoff:"+outcomeCode+":"+motivation,
    conceptualRelation:grammar.conceptualStructure.relation,
    limit:"This single hypothetical evening says nothing conclusive about your character, whether work is meaningful, or your use of a whole life.",
    tension:omitted||"Every allocation leaves less time available for at least one other purpose."
  },
  visual:{type:"segments",labels:categories,values},
  trace:{
    rules:["bounded-budget:180-minutes", "half-hour-zero-sum", "pattern:"+outcomeCode,
       "motivation:"+motivation,"source-relation:deliberate-time"],
    sourceReferences:provenance(record),
    philosophicalClaim:grammar.conceptualStructure.claim,
    epistemicStatus:"contextual_interpretation_not_truth"
  }
 });
}

function reasonWoolf(input){
 const {record,grammar}=getContext(28,"decision_map");
 const s={resource:input?.resource,barrier:input?.barrier,action:input?.action};
 if(!isValidChoice(s.resource,resource)||!isValidChoice(s.barrier,barrier)||!isValidChoice(s.action,response))
   throw new TypeError("Invalid Woolf path");
 const same=s.resource===s.barrier;
 const improvement=resource[s.resource],limitation=barrier[s.barrier];
 const action=response[s.action];
 const structure=same?"incomplete_improvement":"distinct_barrier";
 const result=same?
   "Improving "+improvement+" still leaves it fragile. One improvement is not necessarily enough to sustain creative work.":
   "Improving "+improvement+" still leaves "+limitation+". A single resource cannot remove every barrier.";
 const actionContext=s.action==="write"?
   " Beginning to write preserves agency without making the circumstances fair.":
   s.action==="protect"?
   " Protecting the change acknowledges that opportunity must endure.":
   " Seeking structural change turns attention toward who controls opportunity.";
 const discovery=(result+actionContext).slice(0,230);
 const connection="Woolf's argument concerns enabling conditions for women writers. Money, privacy and institutional access can create opportunity—not guarantee achievement.";
 const question=same?
   "What would turn this temporary improvement into a reliable condition?":
   s.action==="challenge"?
   "When is a personal obstacle actually an institutional one?":
   "What would remain difficult even after this one barrier disappeared?";
 const headline=same?"An opened door can still be hard to enter.":
   s.action==="challenge"?"Freedom also depends on who holds the keys.":
   "One improved condition doesn't erase the others.";
 const nodes=[
  {label:"Improved",value:improvement,kind:"gain"},
  {label:"Still constrained",value:limitation,kind:"barrier"},
  {label:"Next move",value:action,kind:"action"}
 ];
 return createInsightPacket({
   quote:{id:28,text:record.quote.text,author:record.quote.author,source:record.sourcePassage.work},
   mechanism:"decision_map",scenarioId:"women-writing-material-conditions",
   observation:{text:"Improved: "+improvement+" · Still limited by: "+limitation+" · Response: "+action,
     resource:s.resource,barrier:s.barrier,action:s.action},
   insight:{
     headline,discovery,connection,question,ruleId:"dependency:"+structure+":"+s.action,
     conceptualRelation:grammar.conceptualStructure.relation,
     limit:"A fictional branch cannot prove a writer's ability or predict publication. Historical gender and institutional barriers are not reducible to personal preference.",
     tension:"An enabling resource can be present even while other constraints remain."
   },
   visual:{type:"path",nodes},
   trace:{
     rules:["enabling-condition:"+s.resource,"remaining-barrier:"+s.barrier,"response:"+s.action,
       "non-determinism:no-achievement-prediction","source-relation:material-conditions"],
     sourceReferences:provenance(record),
     philosophicalClaim:grammar.conceptualStructure.claim,
     epistemicStatus:"contextual_interpretation_not_truth"
   }
 });
}
function runEncounter(kind,input) {
 if(kind==="seneca")return reasonSeneca(input);
 if(kind==="woolf")return reasonWoolf(input);
 throw new RangeError("Only founder-approved interaction patterns are available in this pilot");
}


/* EXACT RESEARCH MODULE: philosophy-engine/encounter/mechanism-transfer-cases-v02.js */
/**
 * CZ-117 Quote-Derived Transfer v0.2.
 *
 * Research cases, NOT editorially approved interpretations. Separate:
 *   interaction transfer / generic rule-kernel transfer / source fidelity.
 *
 * Source IDs 23/34/49/28/22 reference the exact existing 15-quote Atlas.
 * ID 12 is currently only in bundled app.js and has SECONDARY excerpt
 * corroboration; it is NOT part of the approved Atlas or generalizable.
 * This file changes no existing records or production behavior.
 */


const atlasFor=(id,mechanism)=>{
 const record=ATLAS_PILOT_V01.find(r=>r.id===id);
 if(!record)throw new RangeError("No Context Atlas pilot record for quote "+id);
 const grammar=evaluatePhilosophicalGrammar(record);
 if(mechanism&&grammar.interactiveRealization.candidate!==mechanism)
   throw new Error("Atlas rejects "+mechanism+" for quote "+id);
 if(grammar.interactiveRealization.allowedForProduction!==false)
   throw new Error("Experimental source must not be production eligible");
 return {record,grammar};
};
const b=(id,label,detail)=>Object.freeze({id,label,detail});
const branches=(key,prompt,options)=>Object.freeze({key,prompt,options});
const money=b("income","She earns her own money","An independent financial base");
const room=b("space","She gets a quiet room","Some time without interruptions");
const education=b("education","She receives a serious education","She can develop her own judgment");
const selfDetermination=b("voice","She can make some decisions herself","Others no longer decide everything for her");

const MECHANISM_TRANSFER_CASES=Object.freeze({
 seneca:{
   id:"seneca",quoteId:49,author:"Seneca",family:"tradeoff",
   label:"Seneca · original control",role:"baseline_control",
   review:"provisional_reference",citationSource:"On the Shortness of Life",
   context:"Seneca challenges occupations that consume life without deliberation; the three free hours are an illustrative constraint, not a formula from the text.",
   scenario:"After essential commitments, you have three genuinely free hours tonight. An optional work request arrives, a friend asks to see you, and you hoped for quiet reflection.",
   categories:["Optional work","A friend","Quiet reflection"],
   variableBasis:"Competing discretionary claims on finite time, illustrating deliberate living—not an allocation instructed by Seneca.",
   influences:[
     {id:"chosen",label:"I genuinely wanted this",detail:"I chose how to spend the evening"},
     {id:"expected",label:"Someone expected it",detail:"Another person's expectation mattered"},
     {id:"necessary",label:"I considered it necessary",detail:"One commitment felt difficult to change"}
   ],
   timeFrame:"one_discretionary_evening",
   sourceRelation:"Deliberate use of finite time, not an optimal allocation of hours.",
   guard:"A hypothetical evening cannot reveal the worth of a whole life or determine whether duties are objectively necessary."
 },
 dillard:{
   id:"dillard",quoteId:12,author:"Annie Dillard",family:"tradeoff",
   label:"Annie Dillard · transfer",role:"conditional_transfer",
   review:"outside_atlas_secondary_excerpt_needs_editorial_review",
   quote:"How we spend our days is, of course, how we spend our lives.",
   citationSource:"The Writing Life (1989), scheduling passage",
   sourceUrl:"https://www.dltn.io/posts/annie-dillard-keep-a-daily-routine",
   context:"Dillard discusses a schedule as a deliberate structure that protects time from distraction and makes repeated days into a life. The passage is written about writing and daily routine; it does not rank occupations or prescribe a perfect schedule.",
   scenario:"You want to finish a short story. After dinner you have three free hours, but your phone keeps buzzing and you also need time to rest.",
   categories:["Write your story","Answer messages","Rest and recharge"],
   variableBasis:"Illustrative competing uses of one evening that could, if repeated, form a daily writing routine. These activities are a curated scenario, not named requirements in Dillard's text.",
   influences:[
     {id:"planned",label:"I made a plan to protect my time",detail:"I wanted a routine I could repeat"},
     {id:"interrupted",label:"Other things kept demanding attention",detail:"Messages and requests changed my plan"},
     {id:"obligations",label:"I had other things to get done",detail:"Some everyday demands still mattered"}
   ],
   timeFrame:"hypothetical_repeated_five_weekdays",
   sourceRelation:"Daily schedules accumulate over time; a pattern of chosen hours can shape a life without making any one evening determinative.",
   guard:"The repeated-week calculation is a conditional teaching illustration, not an observation of the user's real habits. Dillard does not say work is bad or that equal time allocations are ideal."
 },
 woolf:{
   id:"woolf",quoteId:28,author:"Virginia Woolf",family:"decision_map",
   label:"Virginia Woolf · original control",role:"baseline_control",
   review:"provisional_reference",
   citationSource:"A Room of One's Own, Chapter I",
   context:"Money, private working space, and access to institutions can enable writing without guaranteeing publication or artistic achievement.",
   startingPoint:"She wants to become a writer",
   scenario:"A young woman wants to write stories, but she works long hours and shares a noisy home. Then one part of her situation has a chance to improve.",
   semanticModel:"enabling_conditions",
   sourceRelation:"The material conditions of creative opportunity are not the same as certainty of achievement.",
   guard:"Keep the historical gendered constraints; a branch is a thought experiment, not an outcome prediction.",
   steps:[
    branches("resource","What improves first?",[money,room]),
    branches("barrier","What still gets in her way?",{
      income:[b("space","She keeps getting interrupted","A secure income alone does not create privacy"),b("access","Nobody will give her a chance","Institutions still decide whose work circulates")],
      space:[b("income","She still needs more money","She needs resources to keep working"),b("access","Nobody will give her a chance","Institutions still decide whose work circulates")]
    }),
    branches("action","How does she respond?",{
