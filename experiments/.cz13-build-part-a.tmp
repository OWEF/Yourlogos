
/* EXACT RESEARCH MODULE: philosophy-engine/context-atlas/pilot-records-v01.js */
/**
 * CZ-110 — Philosophical Context Atlas v0.1 / fifteen-case research pilot.
 *
 * These records are EDITORIAL HYPOTHESES, not proofs, final authorial intent,
 * verified quotations or production-ready encounters. Their text is copied
 * from the stable bundled quote catalogue (app.js), with original IDs.
 * External source links support only the named claims; they are NOT general
 * certifications of an entire record's historical or philosophical accuracy.
 */
const reference = (url, kind, supports) => ({ url, kind, supports });

const item = (id, text, author, source, school, x) => ({
  id,
  quote: { text, author, bundledSource: source, provenanceStatus: x.provenance || "catalogue_only" },
  sourcePassage: {
    work: source,
    language: x.language || "unreviewed",
    locator: x.locator || null,
    originalText: null,
    translation: { exactness: x.exactness || "unverified", translator: x.translator || null },
    references: [reference("app.js", "internal_bundled_catalogue", "quote_identity"), ...(x.refs || [])],
    contextualSummary: x.context,
    contextStatus: x.refs?.length ? "passage_linked_editorial_summary" : "editorial_hypothesis_not_source_verified",
  },
  authorPosition: {
    tradition: Array.isArray(school) ? school : [school],
    stance: x.stance || "editorial_reconstruction",
    periodOrWork: x.period || source,
    scopedSummary: x.position,
    comparisonWithOtherWorks: x.comparison || "Not yet researched; do not assume consistency across an author's entire career.",
  },
  argumentModel: {
    claim: x.claim,
    warrant: x.warrant,
    logicalForm: {
      quantity: x.form[0],
      quality: x.form[1],
      relation: x.form[2],
      modality: x.form[3],
      note: x.formNote,
      interpretationNotLogicalProof: true,
    },
    concepts: x.concepts,
    relation: x.relation,
    scopeOrConditions: x.scope,
    alternativeReadings: x.alternatives,
    challenge: x.challenge,
    limits: x.limits,
  },
  philosophicalOperation: {
    name: x.operation,
    task: x.operationTask,
    target: x.operationTarget,
  },
  interactionModel: {
    candidate: x.mechanic,
    eligibility: x.mechanic === "none" ? "none_suitable" : "conditional",
    scenario: x.scenario || null,
    fitnessReason: x.fitness,
    blocker: x.blocker,
    approval: "not_approved",
    mechanismProof: x.guard || null,
    contraindicatedScenarioIds: x.rejectScenarios || [],
  },
  review: { status: "draft", scholarlyReviewed: false, publisherApproved: false, modelVersion: 1 },
});

const ATLAS_PILOT_V01 = Object.freeze([
  item(0,"He who has a why to live can bear almost any how.","Friedrich Nietzsche","Twilight of the Idols","Nietzschean philosophy",{
