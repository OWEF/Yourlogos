for(const id of ["seneca","woolf","wollstonecraft","kierkegaard","marx"]){
 const spec=MECHANISM_TRANSFER_CASES[id];
 const {grammar}=atlasFor(spec.quoteId);
 if(id==="marx"&&grammar.interactiveRealization.candidate!=="none")throw Error("Expected abstention for Marx");
 if(id==="wollstonecraft"&&grammar.interactiveRealization.candidate!=="decision_map")throw Error("Atlas does not support conditional transfer");
 if(id==="kierkegaard"&&grammar.interactiveRealization.candidate!=="decision_map")throw Error("Atlas does not support temporal stress test");
 if(id==="seneca"&&grammar.interactiveRealization.candidate!=="tradeoff")throw Error("Atlas control changed");
 if(id==="woolf"&&grammar.interactiveRealization.candidate!=="decision_map")throw Error("Atlas control changed");
}
/**
 * Mechanic-vs-content boundary: a Trade-Off scenario must specify its own
 * competing variables and meaning. Two or three is the supported UI range;
 * values and influences are hypotheses curated from contextual research.
 */
function validateTradeoffVariables(spec){
 if(spec.family!=="tradeoff")throw new TypeError("Not a Trade-Off specification");
 const labels=spec.categories, influences=spec.influences;
 if(!Array.isArray(labels)||labels.length<2||labels.length>3 ||
    labels.some(x=>typeof x!=="string"||!x.trim())||
    new Set(labels).size!==labels.length)
   throw new TypeError("Trade-Off needs 2 or 3 distinct, source-relevant variables");
 if(!Array.isArray(influences)||influences.length<2||influences.length>3 ||
    influences.some(x=>!x?.id||!x?.label||!x?.detail)||
    new Set(influences.map(x=>x.id)).size!==influences.length)
   throw new TypeError("Trade-Off needs 2 or 3 valid, distinct influences");
 if(typeof spec.variableBasis!=="string"||!spec.variableBasis.trim()||
    typeof spec.scenario!=="string"||!spec.scenario.trim())
   throw new TypeError("Variable grounding and concrete scenario required");
 return true;
}
for(const id of ["seneca","dillard"])validateTradeoffVariables(MECHANISM_TRANSFER_CASES[id]);

function getMechanismCase(id){
 if(!Object.hasOwn(MECHANISM_TRANSFER_CASES,id))throw new RangeError("Unknown quoted case");
 return MECHANISM_TRANSFER_CASES[id];
}
function optionsFor(spec,key,prior){
 const stage=spec.steps?.find(s=>s.key===key);
 if(!stage)throw new RangeError("Unknown fork stage");
 if(Array.isArray(stage.options))return stage.options;
 if(!Object.hasOwn(stage.options,prior||""))throw new RangeError("No relevant next stage for "+key+"/"+prior);
 return stage.options[prior];
}
function sourceTrace(id){
 const spec=getMechanismCase(id);
 if(spec.quoteId===12)return [
  {url:"app.js",supports:"Bundled quote text and stable ID"},
  {url:spec.sourceUrl,supports:"Secondary excerpt and discussion of schedules in The Writing Life"}
 ];
 const {record}=atlasFor(spec.quoteId);
 const curated=record.sourcePassage.references.map(ref=>({url:ref.url,supports:ref.supports}));
 // A newly located source is a *parallel-study lead*, not a silent editorial
 // promotion of the untouched Atlas record. Kierkegaard's Atlas entry currently
 // contains only the bundled catalogue reference.
 if(spec.sourceUrl&&!curated.some(ref=>ref.url===spec.sourceUrl)){
   curated.push({url:spec.sourceUrl,
     supports:"Additional external passage lead from parallel research; not yet incorporated into the Context Atlas or editorially approved"});
 }
 return curated;
}
function candidateFitAudit(){
 return Object.values(MECHANISM_TRANSFER_CASES).map(spec=>{
   const inAtlas=spec.quoteId!==12;
   const grammar=inAtlas?atlasFor(spec.quoteId).grammar:null;
   return {
    id:spec.id,quoteId:spec.quoteId,role:spec.role,family:spec.family,
    uiTransfer:spec.role==="reject_incompatible"?"blocked":"prototype_testable",
    modelTransfer:spec.role==="baseline_control"?"reference_only":
      spec.id==="dillard"?"conditional_same_allocation_kernel":
      spec.id==="wollstonecraft"?"conditional_same_enabling_condition_kernel":
      spec.id==="kierkegaard"?"ui_only_different_temporal_semantics":"rejected_false_dilemma",
    sourceFit:spec.role==="reject_incompatible"?"atlas_no_fit":
      inAtlas?grammar.interactiveRealization.eligibility:"outside_atlas_source_review_required",
    productionEligible:false,
    review:spec.review,guard:spec.guard
   };
 });
}


/* EXACT RESEARCH MODULE: philosophy-engine/encounter/mechanism-transfer-engine-v02.js */
/**
 * CZ-117 source-derived variable transfer harness.
 *
 * Reuses the already-tested 3-hour zero-sum allocator and invokes original
 * Seneca/Woolf reasoners as reference controls. New candidates are interpreted
 * using one parameterized mechanism kernel and declarative source-linked cases.
 * What transfers is explicitly labelled; no source or generality claim implied.
 */



{reallocateEvening};
const validHalfHour=x=>Number.isInteger(x)&&x>=0&&x<=6;
const MOTIVATIONS=Object.freeze(["chosen","expected","necessary"]);
const uses=(input,spec)=>Array.isArray(input?.ticks)&&
 input.ticks.length===spec.categories.length&&input.ticks.every(validHalfHour)&&
 input.ticks.reduce((a,b)=>a+b,0)===6;
/** Preserve the old three-variable allocator; add a safe two-variable case.
 * The 3h constraint belongs to these scenarios, not to all future quotations. */
function reallocateVariableBudget(ticks,index,value){
 if(!Array.isArray(ticks)||(ticks.length!==2&&ticks.length!==3)||
    ticks.some(v=>!validHalfHour(v))||ticks.reduce((a,b)=>a+b,0)!==6||
    !Number.isInteger(index)||index<0||index>=ticks.length||!validHalfHour(value))
  throw new RangeError("Expected a valid two-or-three-variable, 3-hour allocation");
 if(ticks.length===3)return reallocateEvening(ticks,index,value);
 const result=[...ticks];
 result[index]=value;result[1-index]=6-value;
 return result;
}

function quoteDetails(spec){
 if(spec.quote){
   return {id:spec.quoteId,text:spec.quote,author:spec.author,work:spec.citationSource};
 }
 const record=ATLAS_PILOT_V01.find(r=>r.id===spec.quoteId);
 if(!record||record.quote.author!==spec.author)throw new Error("Control identity mismatch");
 return {id:spec.quoteId,text:record.quote.text,author:record.quote.author,work:record.sourcePassage.work};
}
function assertExperimental(spec){
 if(!["baseline_control","conditional_transfer","stress_test_ui_only"].includes(spec.role))
  throw new Error("Mechanism was deliberately rejected or not curated for transfer");
}
function common(spec,inputs,rules){
 return {
  quote:quoteDetails(spec),
  caseId:spec.id,
  role:spec.role,
  mechanism:spec.family,
  semanticModel:spec.semanticModel||null,
  scenario:spec.scenario||spec.startingPoint,
  context:spec.context,
  sourceRelation:spec.sourceRelation,
  sourceReferences:sourceTrace(spec.id),
  rules,
  guard:spec.guard,
  provisional:true,
  productionEligible:false,
  input:inputs,
  warning:spec.role==="stress_test_ui_only"?
   "The three-fork UI can illustrate this temporal question, but the enabling-condition decision reasoner has NOT transferred. Future outcomes are not determined.":
   spec.role==="conditional_transfer"?
   "Research transfer hypothesis only. Mechanism fit and interpretation need independent editorial validation.":
   "Existing quotation-specific prototype used as a control."
 };
}
function evaluateTradeoffCase(id,input){
 const spec=getMechanismCase(id);
 assertExperimental(spec);
 if(spec.family!=="tradeoff")throw new RangeError("Not a Trade-Off case");
 validateTradeoffVariables(spec);
 if(!uses(input,spec)||!spec.influences.some(m=>m.id===input.motivation))
  throw new TypeError("Exactly 3 free hours across source-grounded variables and a valid influence are required");
 const hours=input.ticks.map(n=>n/2),max=Math.max(...hours),leaders=hours.filter(n=>n===max).length;
 const omitted=hours.map((n,i)=>n===0?spec.categories[i]:null).filter(Boolean);
 const observation=spec.categories.map((name,i)=>name+": "+hours[i]+"h").join(" · ");
 const fields={
  mechanism:"tradeoff",
  budget:3,
  hours,
  observation,
  variableCount:spec.categories.length,
  variableBasis:spec.variableBasis,
  variableLabels:[...spec.categories],
  influenceLabel:spec.influences.find(m=>m.id===input.motivation).label,
  pattern:max===3?"one_activity":leaders>1?"balanced_maxima":"uneven_allocation",
  alternativesOmitted:omitted,
  influence:input.motivation,
  conditionalFiveWeekdays:spec.timeFrame==="hypothetical_repeated_five_weekdays"?
   hours.map(n=>n*5):null
 };
 const sourceRelation=spec.timeFrame==="hypothetical_repeated_five_weekdays"?
  spec.sourceRelation+" Five identical hypothetical evenings would give "+
  fields.conditionalFiveWeekdays.map((h,i)=>spec.categories[i]+" "+h+"h").join(", ")+
  " across a five-day week; the user's real routine is unknown.":
  spec.sourceRelation+" This is a *single* imagined evening, not an inference about an actual life.";
 const rules=["fixed_budget:180_minutes","half_hour_zero_sum","variables:"+spec.categories.length,
   "quote_specific_variables_not_copied","observed_pattern:"+fields.pattern,
   "self_declared_motivation:"+input.motivation,"no_moral_optimization",
   spec.timeFrame==="hypothetical_repeated_five_weekdays"?"conditional_repetition_not_empirical":"single_evening_no_lifetime_inference"];
 const base=common(spec,{ticks:[...input.ticks],motivation:input.motivation},rules);
 const reference=spec.role==="baseline_control"?reasonSeneca(input):null;
 return {...base,fields,interpretation:sourceRelation,referenceInsight:reference?.insight||null,
  semanticTransfer:spec.role==="baseline_control"?"reference_quote_specific_adapter":"conditional_constraint_kernel_transfer"};
}
function reachableDecisionRoutes(caseId){
 const spec=getMechanismCase(caseId);
 assertExperimental(spec);
 if(spec.family!=="decision_map")throw new RangeError("Not a Decision Map case");
 const paths=[];
 for(const first of optionsFor(spec,"resource",null)){
  for(const second of optionsFor(spec,"barrier",first.id)){
   for(const third of optionsFor(spec,"action",second.id)){
    paths.push({resource:first.id,barrier:second.id,action:third.id});
   }
  }
 }
 return paths;
}
function evaluateDecisionCase(id,input){
 const spec=getMechanismCase(id);
 assertExperimental(spec);
 if(spec.family!=="decision_map")throw new RangeError("Not a Decision Map case");
 const required=["resource","barrier","action"];
 if(!input||typeof input!=="object"||required.some(k=>typeof input[k]!=="string"))
  throw new TypeError("All three explicitly chosen decision forks are required");
 const selected=[];
 let predecessor=null;
 for(const key of required){
  const choices=optionsFor(spec,key,predecessor);
  const matching=choices.find(choice=>choice.id===input[key]);
  if(!matching)throw new RangeError("Incompatible choice "+key+" = "+input[key]+" (previous: "+predecessor+")");
  selected.push({key,id:matching.id,label:matching.label,detail:matching.detail});
  predecessor=matching.id;
 }
 const [improvement,obstacle,response]=selected;
 const rules=["first_fork:"+improvement.id,"second_fork_depends_on_first:"+obstacle.id,
   "third_fork_depends_on_second:"+response.id,"no_deterministic_future"];
 const base=common(spec,{...input},rules);
 const reference=spec.role==="baseline_control"?reasonWoolf(input):null;
 const temporal=spec.semanticModel==="temporal_information_asymmetry";
 const result={
  ...base,
  selected,
  observation:selected.map(n=>n.label).join(" → "),
  interpretation:temporal?
   "At the time of the first step, the later uncertainty was not known. Looking back may change the account of that decision, but this simulation cannot reveal what truly would have happened otherwise.":
   improvement.label+" changes one condition. "+obstacle.label+" still limits the path. "+response.label+
   " is a possible response—not a guarantee of independence or achievement.",
  referenceInsight:reference?.insight||null,
  semanticTransfer:temporal?"UI_only_temporal_asymmetry_needs_new_kernel":
   spec.role==="baseline_control"?"reference_quote_specific_adapter":"conditional_enabling_condition_kernel_transfer",
  futureKnownAtChoice:false,
  outcomePredicted:false
 };
 return result;
}
function evaluateTransferCase(id,input){
 const spec=getMechanismCase(id);
 if(spec.role==="reject_incompatible")return {
  caseId:id,blocked:true,mechanism:spec.requestedMechanism,reason:spec.guard,
  quote:quoteDetails(spec),sourceReferences:sourceTrace(id),productionEligible:false
 };
 return spec.family==="tradeoff"?evaluateTradeoffCase(id,input):evaluateDecisionCase(id,input);
}
function fitMatrix(){
 return candidateFitAudit();
}


/* EXACT RESEARCH MODULE: philosophy-engine/encounter/kernel-contexts-v11.js */
// The texts and their limits are editorial inputs. Household purchases, a print
// workshop and the two decision graphs are invented teaching scenarios.
const transferContexts={
 thoreau:{
  id:"thoreau",author:"Henry David Thoreau",quote:"the cost of a thing is the amount of what I will call life which is required to be exchanged for it",
  source:{work:"Walden · Economy (excerpt)",url:"https://digitalthoreau.org/walden/fluid/text/01.html"},
  scenario:"You are furnishing a room. Each spending token is $20 earned in an extra hour of work. Choose what to buy and how much of the available budget to use.",
  mechanism:"tradeoff",operations:["tradeoff"],assumptions:["Only these purchases require extra shifts, at a constant net wage."],
  operation:"conversion",questions:{zero:"What does deciding against the purchase leave you free to do?"},distinction:"Price paid / time given",relation:"Thoreau considers shelter in terms of the life exchanged for it. An affordable purchase can still claim a portion of a working life.",
  limit:"No price establishes that a purchase is worthwhile or wasteful.",question:"Which purchase looks different when you read its price as part of a working day?",
  model:{resources:[{id:"money",label:"Available $20 tokens",min:4,max:12,type:"cap"}],
   choices:[{id:"repair",label:"chair repairs",singular:"chair repair",cost:[1],max:4},{id:"lamp",label:"reading lamps",singular:"reading lamp",cost:[2],max:3},{id:"shelf",label:"shelves",singular:"shelf",cost:[3],max:3}],
   initial:{amounts:[1,1,0],budgets:[8]},metric:{op:"sum",weights:[1,2,3],unit:"extra working hours",singular:"extra working hour"}}
 },
 smith:{
  id:"smith",author:"Adam Smith",quote:"Those ten persons, therefore, could make among them upwards of forty-eight thousand pins in a day.",
  source:{work:"The Wealth of Nations · I.i",url:"https://www.d.umn.edu/cla/faculty/jhamlin/4111/Smith/SmithDV1.html"},
  scenario:"Four volunteers are printing booklets. A press operator prints two sets of pages, and a binder finishes one set. Assign everyone for one shift.",
  mechanism:"tradeoff",operations:["tradeoff"],assumptions:["Each booklet needs both operations; these invented rates hold for this shift."],
  operation:"complementarity",questions:{gain:"How could the same number of workers finish more when one changes tasks?"},distinction:"Hands assigned / work finished",relation:"Smith’s pin makers produce together what an isolated worker could scarcely make alone. Here a printed set still needs a binder: the arrangement of the hands matters as much as their number.",
  limit:"These rates cannot establish historical productivity, welfare, or a universally best division of labour.",question:"What does the last finished booklet owe to the way the work was divided?",
  model:{resources:[{id:"team",label:"Volunteers",min:4,max:4,type:"exact"}],
   choices:[{id:"press",label:"press operators",singular:"press operator",cost:[1],max:4},{id:"bind",label:"binders",singular:"binder",cost:[1],max:4}],
   initial:{amounts:[3,1],budgets:[4]},metric:{op:"minimum",weights:[2,1],unit:"finished booklets",singular:"finished booklet"}}
 },
 epictetus:{
  id:"epictetus",author:"Epictetus",quote:"Some things are in our control and others not.",
  source:{work:"Enchiridion · §1, Elizabeth Carter translation",url:"https://barryfvaughan.org/text/philtext/epictetus/enchiridion.html"},
  scenario:"You have one place to apply for a workshop. You can send an application, revise it, or let the deadline pass. The organizer decides whom to admit.",
  mechanism:"decision_map",operations:["decision_map"],assumptions:["Submitting closes editing for this application."],
  operation:"agency",control:{action:"Sending the application",external:"admission"},distinction:"One’s own action / another person’s judgment",relation:"The distinction concerns what belongs to your agency. You can decide what to submit; even a careful revision cannot give you the organizer’s power of admission.",
  limit:"No path establishes admission, indifference, or a reader’s character.",question:"Where does your choice end and the organizer’s judgment begin along this route?",
  model:{start:"draft",initial:["Admission belongs to the organizer"],nodes:{
   draft:{prompt:"What do you do with the draft?",options:[
    {id:"send",label:"Send the application",next:"sent",closes:["revise"],reveal:["The submitted draft is final"]},
    {id:"revise",label:"Ask a friend to read it",next:"review",reveal:["Your friend flags an unclear example"]},
    {id:"pass",label:"Let the deadline pass",next:null,reveal:["No application was submitted"]}]},
   review:{prompt:"Your friend flags an unclear example.",options:[
    {id:"edit",label:"Clarify the example and submit",next:"sent",closes:["revise"],reveal:["The submitted draft is final"]},
    {id:"pass",label:"Let the deadline pass",next:null,reveal:["No application was submitted"]}]},
   sent:{prompt:"Your application is in. The organizer has yet to decide.",options:[
    {id:"prepare",label:"Prepare a practice session",next:null},{id:"wait",label:"Wait for the decision",next:null},
    {id:"revise",label:"Revise the submitted draft",next:null}]}
  }}
 },
 descartes:{
  id:"descartes",author:"René Descartes",quote:"The first was never to accept anything for true which I did not clearly know to be such",
  source:{work:"Discourse on the Method · II (excerpt)",url:"https://en.wikisource.org/wiki/Discourse_on_the_Method/Part_2"},
  scenario:"Two summaries of a town vote disagree. A newsletter is due, and you must decide what you can responsibly report.",
  mechanism:"decision_map",operations:["decision_map"],assumptions:["The signed minutes settle the vote in this illustration, not every question about it."],
  operation:"information",questions:{revision:"Which evidence let you change what the newsletter would say before it went to print?"},distinction:"Receiving an assertion / grounds for assent",relation:"Descartes asks what licenses the step from considering a claim to accepting it. A deadline can force an editorial decision while leaving the question of truth open. Checking minutes illustrates only the restraint in his first rule.",
  limit:"A document check is not Cartesian clear and distinct knowledge; neither haste nor doubt proves a claim false.",question:"Which fact available when you acted could actually support the claim you would print?",
  model:{start:"reports",initial:["The two reports disagree"],nodes:{
   reports:{prompt:"Two accounts disagree. What next?",options:[
    {id:"hold",label:"Withhold the figure",next:null},
    {id:"print",label:"Print the first report",next:null,closes:["withdraw-before-print"]},
    {id:"seek",label:"Request the minutes",next:"reply",reveal:["The clerk sends an unsigned draft"]}]},
   reply:{prompt:"The clerk sends an unsigned draft.",options:[
    {id:"qualify",label:"Pencil in a provisional figure",sets:{report:"provisional"},next:"proof",reveal:["The signed minutes arrive before printing"]},
    {id:"verify",label:"Check for a signed version",next:"confirmed",reveal:["The signed minutes confirm the second report"]}]},
   proof:{prompt:"The signed minutes arrive while you can still change the page.",options:[
    {id:"amend",label:"Replace the provisional figure with the signed result",sets:{report:"confirmed"},next:null},
    {id:"omit",label:"Remove the provisional figure",sets:{report:"withheld"},next:null}]},
   confirmed:{prompt:"The signed minutes confirm the second report.",options:[
    {id:"cite",label:"Publish the confirmed figure with its source",next:null,requires:["The signed minutes confirm the second report"]},
    {id:"hold",label:"Defer publication",next:null}]}
  }}
 }
